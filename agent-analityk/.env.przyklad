# Skopiuj ten plik jako `.env` (bez rozszerzenia) i wklej swój klucz.
# W Terminalu, będąc w katalogu programu:
#     cp .env.przyklad .env
#     open -e .env
#
# Klucz pobierzesz z https://console.anthropic.com -> API Keys.
# To osobna, płatna usługa — abonament claude.ai jej nie obejmuje.
#
# UWAGA: pliku `.env` nigdy nie wysyłaj i nie wrzucaj do repozytorium.
# Jest w .gitignore, więc git go zignoruje.

ANTHROPIC_API_KEY=sk-ant-tutaj-wklej-swoj-klucz
